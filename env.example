# Server
PORT=5000
NODE_ENV=development

# Database: Default is Zero-Setup Embedded Engine (NO MongoDB required!).
# If you ever want external MongoDB, set USE_MONGO=true and provide MONGO_URI:
USE_MONGO=false
MONGO_URI=mongodb://127.0.0.1:27017/mentra

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Only needed if the frontend is served from a different origin
CLIENT_ORIGIN=

# Optional Python matching module (see ai/README.md). Leave false to use the built-in keyword engine.
AI_ENABLED=false
PYTHON_BIN=python3

# Alpha test: comma-separated emails allowed to open the Alpha Report page and CSV export
ALPHA_ADMIN_EMAILS=
